# Copia este archivo como backend/.env y rellena los valores. backend/.env NO se versiona.
ENZONA_DB_URL=jdbc:postgresql://<host>:<puerto>/defaultdb?sslmode=require
ENZONA_DB_USER=avnadmin
ENZONA_DB_PASSWORD=<contraseña>
# Cadenas aleatorias de 64+ caracteres (por ejemplo: openssl rand -hex 48)
ENZONA_JWT_SECRET=<cadena aleatoria de 64+ caracteres>
ENZONA_HMAC_SECRET=<otra cadena aleatoria de 64+ caracteres>
# Clave AES-256 para cifrar la CURP en reposo (64 caracteres hexadecimales: openssl rand -hex 32)
ENZONA_CURP_KEY=<64 caracteres hexadecimales>
# Opcionales
ENZONA_CORS_ORIGINS=http://localhost:5173
